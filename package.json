{
  "name": "docugraph-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DocuGraph AI – Multi-layer Knowledge Assistant",
  "scripts": {
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
