# ============================================================
# DocuGraph AI – Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-32chars

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Neo4j (Aura) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- PostgreSQL + pgvector ---
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/docugraph

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Redis (Celery Broker) ---
REDIS_URL=redis://localhost:6379/0

# --- File Upload ---
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
SUPABASE_STORAGE_BUCKET=docugraph-files
FILE_AUTO_DELETE_HOURS=24

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:3000

